# Memo no Sekai runs with no configuration at all: without DATABASE_URL the
# workspace is kept in the browser (IndexedDB) and never leaves the device.
#
# Everything below is optional, for a deployment that should sync one workspace
# across devices.

# PostgreSQL connection string. Apply database/schema.sql first, or let the app
# create the table on its first request.
# DATABASE_URL=postgresql://user:password@host:5432/memo_no_sekai

# Required in production whenever DATABASE_URL is set.
#
# /api/notes has no per-user identity, so without a passphrase the stored
# workspace would be readable and writable by anyone who can reach the URL. The
# app refuses to enable the server store until this is set; each device enters
# the same passphrase once, under Settings.
# MEMO_ACCESS_TOKEN=choose-a-long-random-passphrase

# Canonical URL, used for Open Graph and canonical links. On Vercel this is
# detected automatically and can be left unset.
# NEXT_PUBLIC_SITE_URL=https://memo.example.com

# Where the development SQLite file lives. Defaults to ./data/memo-no-sekai.sqlite
# MEMO_SQLITE_PATH=./data/memo-no-sekai.sqlite
